# Node
node_modules/
dist/
*.tgz

# Nix
result

# OS
Thumbs.db

# Per-user Claude Code config. Keep personal settings and unrelated skills
# ignored while allowing MEX's official project skills to be committed.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/mex-inbox/
!.claude/skills/mex-inbox/**
!.claude/skills/mex-relay/
!.claude/skills/mex-relay/**
!.claude/skills/mex-statechart/
!.claude/skills/mex-statechart/**

# Code graph build artifact (rebuilt by `mex graph`)
.mex/graph.db*

# Per-user team state (configured member, Catch Up cursors, and local jobs)
.mex/local/

# Derived wiki index (rebuilt by `mex wiki rebuild-index`). Markdown under
# .mex/ is canonical; this database is a disposable projection of it.
.mex/wiki.db*

# Eval harness results (regenerated by `npm run eval`). They live under .mex so
# graph builds cannot accidentally index archived CLI source as subject code.
.mex/eval-results/
evaluate/results/

# Browser-test output (visual baselines under test/hub-e2e are tracked)
playwright-report/
test-results/
blob-report/

#misc
claude-talks
.demo
MEX_NATIVE_CODE_GRAPH_BENCHMARK_REPORT.md
CODE_GRAPH_STARTER_ISSUES_DRAFT.md
docs/launch/

# Bundled statechart helper is produced by build:node, shipped in the tarball.
skills/mex-statechart/scripts/runtime.mjs
