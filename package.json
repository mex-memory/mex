{
  "name": "mex-agent",
  "version": "0.8.2",
  "description": "Persistent project memory and deterministic local code graphs for AI coding agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mex": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "LICENSE",
    "README.md",
    "TELEMETRY.md",
    "COMPATIBILITY.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "scaffold",
    "drift-detection",
    "documentation",
    "code-graph",
    "tree-sitter",
    "sqlite",
    "cli",
    "claude",
    "cursor",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mex-memory/mex.git"
  },
  "author": "Daksh Jaitly",
  "license": "MIT",
  "homepage": "https://github.com/mex-memory/mex#readme",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:hub",
    "build:contracts": "npm run build --workspace @mex/hub-contracts",
    "build:node": "npm run build:contracts && tsup && node scripts/copy-graph-assets.mjs",
    "build:hub": "npm run build --workspace @mex/hub-web",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:hub:web": "npm run test --workspace @mex/hub-web",
    "test:hub:e2e": "npm run build && playwright test",
    "test:hub:package": "node scripts/hub-pack-smoke.mjs",
    "test:watch": "vitest",
    "eval": "node evaluate/graph/index.mjs",
    "eval:legacy": "node evaluate/index.mjs",
    "eval:graph": "node evaluate/graph/index.mjs",
    "eval:graph:test": "node --test evaluate/graph/test/*.test.mjs",
    "eval:test": "npm run eval:graph:test && npm run eval:compare:test",
    "eval:e2e": "node evaluate/agent-e2e.mjs",
    "eval:compare": "node evaluate/compare/index.mjs",
    "eval:compare:test": "node --test evaluate/compare/test/*.test.mjs",
    "benchmark:graph-status": "npm run build && node scripts/benchmark-graph-status.mjs",
    "benchmark:release": "npm run build && node scripts/release-benchmark/enforce.mjs --output test-results/release-benchmark/report.json",
    "typecheck": "npm run typecheck --workspace @mex/hub-contracts && tsc --noEmit && npm run typecheck --workspace @mex/hub-web",
    "prepare": "npm run build",
    "benchmark:telemetry": "npm run build && node scripts/benchmark-telemetry.mjs",
    "benchmark:telemetry:test": "node --test scripts/benchmark-telemetry.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "glob": "^13.0.6",
    "hono": "^4.13.3",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "simple-git": "^3.27.0",
    "typescript": "5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "web-tree-sitter": "^0.25.10",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tree-sitter-wasms": "^0.1.12",
    "tsup": "^8.4.0",
    "vitest": "^3.0.0"
  }
}
